# Copy to .env and fill in your values

# Only needed for running the eval suite (tests/test_evals.py) — end users
# enter their own Anthropic API key in the app's sidebar instead.
ANTHROPIC_API_KEY=sk-ant-...

# MotherDuck: persistent storage backend, shared across users (partitioned by
# a hash of each user's Anthropic API key — see src/penny/ui/session.py)
MOTHERDUCK_TOKEN=

# The model every Claude call in the app uses (chat, sub-agent delegation,
# merchant enrichment, spending insights). Optional — defaults to Haiku if unset.
PENNY_MODEL=claude-haiku-4-5-20251001
